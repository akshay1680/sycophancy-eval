# Copy this file OUTSIDE the repo (e.g. ~/.secrets/sycoeval.env), fill it in,
# then:  export SYCOEVAL_ENV=~/.secrets/sycoeval.env
# Only the providers you use need a key. Ollama runs locally and needs none.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: which model each adapter calls (defaults in sycoeval/models.py)
OLLAMA_MODEL=gemma4:e2b
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
